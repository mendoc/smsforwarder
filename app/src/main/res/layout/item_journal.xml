<?xml version="1.0" encoding="utf-8"?>
<!-- Un SMS du journal, précédé du titre de son jour quand il est le premier de ce jour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/journal_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plex_sans_semibold"
        android:letterSpacing="0.06"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:textAllCaps="true"
        android:textColor="@color/ink_2"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/journal_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_journal_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/journal_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plex_sans_semibold"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/journal_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plex_mono_regular"
                android:textColor="@color/ink_2"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/journal_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/plex_sans_regular"
            android:lineSpacingExtra="3sp"
            android:textColor="@color/ink_body"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/journal_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            android:id="@+id/journal_deliveries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plex_mono_regular"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/ink_2"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
